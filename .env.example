# Django Settings
SECRET_KEY=your_django_secret_key_here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Settings
DB_NAME=restromind_ai_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432
FRONTEND_BASE_URL=http://localhost:3000

# CORS Settings (Comma-separated list of allowed origins in production)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Throttling / Rate limiting settings (requests per minute per IP for authentication views)
AUTH_THROTTLE_RATE=5/minute

# JWT settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Django logging configuration (DEBUG, INFO, WARNING, ERROR, CRITICAL)
DJANGO_LOG_LEVEL=INFO

# Pagination settings
ADMIN_PAGINATION_PAGE_SIZE=10



